# n-cartpole firmware defaults (ESP-IDF v5.3.1). Board: ESP32-S3, 16 MB quad flash,
# 8 MB octal PSRAM (e.g. ESP32-S3-DevKitC-1 N16R8). See docs/design.md.
CONFIG_IDF_TARGET="esp32s3"

# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# OTA rollback: a new image boots "pending verify" and must mark itself valid
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# CPU, caches, PSRAM
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 32 KB: the other 32 KB of the data cache's SRAM becomes heap, and with the weights in internal
# RAM the PSRAM traffic the cache absorbs is small.
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS: 1 kHz tick, run-time stats (µs, esp_timer) + core id for the task table
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Core 0 gets everything but the control loop (core 1 runs only ctrl + IDLE1 + ipc1)
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y

# Task watchdog: 5 s, both idle tasks watched (ctrl subscribes itself)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# HTTP server + WebSocket
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Network
CONFIG_LWIP_LOCAL_HOSTNAME="cartpole"

# Sockets: httpd (7 + 3 internal) plus headroom
CONFIG_LWIP_MAX_SOCKETS=16

# Internal RAM budget: the ~154 KB of f32 actor weights only run at full speed from internal RAM
# (from PSRAM they stream at ~75 MB/s: ~2 ms per tick), and Wi-Fi/lwIP used most of the heap.
# Put their dynamic allocations in PSRAM, drop the IRAM-resident Wi-Fi fast paths (they sit in
# the same SRAM pool as the heap and nothing here needs the throughput) and trim the buffer pools.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
